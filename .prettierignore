# в functions/_shared.js), Prettier тут только создавал бы лишний дифф
# при каждом сохранении из админки.
*.json
package-lock.json

# HTML-страницы: внутри лежат большие <style>/<script> блоки, и
# переформатирование дало бы дифф на тысячи строк, в котором утонет
# любая осмысленная правка.
*.html

# js/ и functions/ пока тоже не форматируем автоматически.
# Код там написан с выравниванием по колонкам:
#
#     const info     = findReviewForTitle(...);
#     const tagLabel = TYPE_LABELS[r.type] || ...;
#
# Prettier такое выравнивание не сохраняет — прогон переписал бы ~950
# строк и стёр авторский стиль заодно с историей git blame.
# Это решение о вкусе, а не о качестве, поэтому оно за владельцем кода:
# захочешь перейти на единый машинный стиль — убери две строки ниже
# и один раз выполни `npm run format` отдельным коммитом.
js/
functions/

# style.css — по той же причине: правила написаны компактными
# однострочниками, Prettier раскрыл бы их и раздул файл на ~450 строк.
